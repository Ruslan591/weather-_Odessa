{"task_id": "cl-1791643871", "cmd": "cd /opt/trading-bot && echo '' | base64 -d > wallbot_new.py && chown tbot:tbot wallbot_new.py && venv/bin/python -m py_compile wallbot_new.py && echo COMPILED\nsudo -u tbot venv/bin/python - <<'PY'\nimport wallbot_new as w, urllib.request, json, sqlite3, statistics\ndb = sqlite3.connect(\":memory:\"); db.executescript(w.SCHEMA2)\neng = w.WallEngine(w.CFG, db)\nfor sym in w.CFG[\"PAIRS\"]:\n    dep = json.load(urllib.request.urlopen(\"https://api.binance.com/api/v3/depth?symbol=%s&limit=500\" % sym))\n    bids = [(float(a), float(b)) for a, b in dep[\"bids\"]]\n    info, S, pr, nv, med, bid0 = eng.clus_find(bids)\n    span = (bid0 - pr[-1]) / bid0 * 1e4\n    if info:\n        print(sym, \"\u0433\u043b\u0443\u0431\u0438\u043d\u0430 %.0f \u0431.\u043f.\" % span, \"| \u0442\u0438\u043f\u0438\u0447\u043d\u043e\u0435 \u043e\u043a\u043d\u043e %.0f USDT\" % med, \"| \u0441\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435 %.0fk USDT, %.1f\u2013%.1f \u0431.\u043f. \u043d\u0438\u0436\u0435, x%.1f\" % (info[\"usdt\"]/1e3, info[\"d1\"], info[\"d2\"], info[\"usdt\"]/med))\n    else:\n        print(sym, \"\u0433\u043b\u0443\u0431\u0438\u043d\u0430 %.0f \u0431.\u043f.\" % span, \"| \u0442\u0438\u043f\u0438\u0447\u043d\u043e\u0435 \u043e\u043a\u043d\u043e %.0f USDT\" % med, \"| \u0441\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u044f \u043d\u0435\u0442, \u043c\u0430\u043a\u0441 \u043e\u043a\u043d\u043e x%.1f\" % (max(S[i] for i in range(len(S)) if (bid0-pr[i])/bid0*1e4 <= 60)/med if med else 0))\nPY", "timeout": 90}