{"task_id": "cl-1791653748", "cmd": "set -e\ncd /opt/trading-bot\necho '' | base64 -d > wallbot_new.py\nvenv/bin/python -m py_compile wallbot_new.py\necho \"--- unit:\"; systemctl show wallbot -p Environment -p EnvironmentFiles -p ExecStart | cut -c1-300\necho \"--- \u043f\u043e\u0440\u043e\u0433\u0438 \u0441\u0442\u0435\u043d\u043a\u0438 \u043f\u043e \u043f\u0430\u0440\u0430\u043c (\u0436\u0438\u0432\u044b\u0435 \u0441\u0442\u0430\u043a\u0430\u043d\u044b):\"\nsudo -u tbot venv/bin/python - <<'PY'\nimport wallbot_new as w, urllib.request, json, statistics\nfor sym in w.CFG[\"PAIRS\"]:\n    dep = json.load(urllib.request.urlopen(\"https://api.binance.com/api/v3/depth?symbol=%s&limit=500\" % sym))\n    b = [(float(a), float(q)) for a, q in dep[\"bids\"]]; b0 = b[0][0]\n    near = [p*q for p, q in b if (b0-p)/b0*1e4 <= 100]\n    typ = statistics.median(near)\n    print(\"%-9s \u0442\u0438\u043f\u0438\u0447\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c %7.0f  \u043f\u043e\u0440\u043e\u0433 \u0441\u0442\u0435\u043d\u043a\u0438 %7.0f\" % (sym, typ, max(w.CFG[\"WALL_MIN_USDT\"], w.CFG[\"WALL_FLOOR_X\"]*typ)))\nPY", "timeout": 90}